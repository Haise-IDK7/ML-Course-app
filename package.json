{
  "name": "ml-course-app",
  "productName": "Curso ML",
  "version": "1.0.0",
  "description": "Curso interactivo de machine learning, redes neuronales, deep learning, CNN y PINNs",
  "author": "Haise-IDK7",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "pdf": "node scripts/build-pdf.mjs",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@fontsource-variable/source-serif-4": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "@vscode/markdown-it-katex": "^1.1.1",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.3"
  },
  "build": {
    "appId": "io.github.haise-idk7.mlcourse",
    "productName": "Curso ML",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png"
    }
  }
}
